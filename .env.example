# --- Required in production ---
# Random string, 16+ chars. Signs the hand-off between the two form steps.
TOKEN_SECRET=
# Google Apps Script web-app URL (scripts/google-apps-script.js) + shared secret.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Business details (shown in footer and legal pages) ---
NEXT_PUBLIC_SITE_URL=https://weddingwell.vercel.app
NEXT_PUBLIC_LAUNCH_CITY=Hyderabad
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DEPOSIT_INR=1499
NEXT_PUBLIC_REFUND_DAYS=7
NEXT_PUBLIC_DELETION_DAYS=15

# --- A/B tests: any of message, price, commitment ---
ACTIVE_TESTS=message,price

# --- Payments (Razorpay payment links). Without keys, deposit requests are saved and the link is sent manually. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp provider webhook (optional) ---
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# --- AI Chatbot (Groq API) ---
# Get free API key from https://console.groq.com
GROQ_API_KEY=

# Test route protection (production only - set to random string)
SECRET_TEST_KEY=

# --- Google OAuth (for user authentication) ---
# Get credentials from https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID with authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google (development)
#   - https://your-domain.com/api/auth/callback/google (production)
# Scopes requested: email, profile, phone numbers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NextAuth secret (random string, 32+ chars) - generate with: openssl rand -base64 32
AUTH_SECRET=

# --- AI Chat Feature (DISABLED) ---
# AWS SES for email OTP
# AWS_SES_SMTP_USERNAME=
# AWS_SES_SMTP_PASSWORD=
# AWS_SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# AWS_SES_SMTP_PORT=587
# AWS_SES_FROM_EMAIL=
# AWS_SES_FROM_NAME=WeddingWell

# Google Gemini AI API
# GEMINI_API_KEY=

# Test route protection
# SECRET_TEST_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
