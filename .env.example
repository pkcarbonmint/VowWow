# --- Required in production ---
# Random string, 16+ chars. Signs the hand-off between the two form steps.
TOKEN_SECRET=
# Google Apps Script web-app URL (scripts/google-apps-script.js) + shared secret.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Business details (shown in footer and legal pages) ---
NEXT_PUBLIC_SITE_URL=https://weddingwell.vercel.app
NEXT_PUBLIC_LAUNCH_CITY=Delhi NCR
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_DEPOSIT_INR=1499
NEXT_PUBLIC_REFUND_DAYS=7
NEXT_PUBLIC_DELETION_DAYS=15

# --- A/B tests: any of message, price, commitment ---
ACTIVE_TESTS=message,price

# --- Payments (Razorpay payment links). Without keys, deposit requests are saved and the link is sent manually. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp provider webhook (optional) ---
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
